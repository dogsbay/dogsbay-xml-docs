{
  "name": "dogsbay-xml",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node ./dogsbay-mount.mjs clean && astro build && pagefind --site dist --output-path dist/dogsbay-xml-docs/pagefind && node ./dogsbay-mount.mjs finalize",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "astro": "^7.0.4",
    "pagefind": "^1.4.0",
    "tailwindcss": "^4.3.2",
    "@tailwindcss/vite": "^4.3.2",
    "tailwind-variants": "^0.3.0",
    "shiki": "^4.0.0",
    "@shikijs/transformers": "^4.0.0",
    "katex": "^0.16.44",
    "markdown-it": "^14.1.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-deflist": "^3.0.0",
    "@dogsbay/docs-layout": "0.2.0-beta.115",
    "@dogsbay/ui": "0.2.0-beta.115",
    "@dogsbay/types": "0.2.0-beta.115",
    "@dogsbay/primitives": "0.2.0-beta.115",
    "@dogsbay/icons": "0.2.0-beta.115",
    "@dogsbay/elements": "0.2.0-beta.115",
    "@floating-ui/core": "^1.7.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
