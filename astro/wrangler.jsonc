{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dogsbay-xml-docs",
  "compatibility_date": "2026-04-01",

  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },

  "routes": [
    // Both patterns, as the blog has: "/dogsbay-xml-docs/*" does not match the
    // bare "/dogsbay-xml-docs", which would fall through to the apex worker and
    // 404 — and that path is the documentation's home page.
    { "pattern": "dogsbay.ai/dogsbay-xml-docs", "zone_name": "dogsbay.ai" },
    { "pattern": "dogsbay.ai/dogsbay-xml-docs/*", "zone_name": "dogsbay.ai" }
  ]
}
