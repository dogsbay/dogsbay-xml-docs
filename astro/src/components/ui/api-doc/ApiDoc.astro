---
import CodeBlock from "../code-block/CodeBlock.astro";

interface Props {
  html: string;
}

const { html } = Astro.props;

interface Segment {
  type: "html" | "code";
  content: string;
  lang?: string;
}

function splitCodeBlocks(src: string): Segment[] {
  const segments: Segment[] = [];
  const re = /<pre><code(?:\s+class="language-(\w+)")?>([\s\S]*?)<\/code><\/pre>/g;
  let lastIndex = 0;
  let match;

  while ((match = re.exec(src)) !== null) {
    if (match.index > lastIndex) {
      segments.push({ type: "html", content: src.slice(lastIndex, match.index) });
    }
    const lang = match[1] || "python";
    const code = match[2]
      .replace(/&amp;/g, "&")
      .replace(/&lt;/g, "<")
      .replace(/&gt;/g, ">")
      .replace(/&quot;/g, '"');
    segments.push({ type: "code", content: code, lang });
    lastIndex = match.index + match[0].length;
  }

  if (lastIndex < src.length) {
    segments.push({ type: "html", content: src.slice(lastIndex) });
  }

  return segments;
}

const segments = splitCodeBlocks(html);
---

{segments.map((seg) =>
  seg.type === "html" ? (
    <div class="prose prose-sm dark:prose-invert max-w-none [&>p:first-child]:mt-0 [&>p:last-child]:mb-2" set:html={seg.content} />
  ) : (
    <CodeBlock code={seg.content} lang={seg.lang || "python"} />
  )
)}
