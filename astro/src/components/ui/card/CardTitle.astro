---
import { tv } from "tailwind-variants";

const cardTitle = tv({
  base: "text-2xl font-semibold leading-none tracking-tight",
});

interface Props {
  class?: string;
  [key: string]: unknown;
}
const { class: className, ...rest } = Astro.props;
---

<h3 class={cardTitle({ class: className })} {...rest}>
  <slot />
</h3>
