---
import { tv } from "tailwind-variants";

const cardDescription = tv({
  base: "text-sm text-muted-foreground",
});

interface Props {
  class?: string;
  [key: string]: unknown;
}
const { class: className, ...rest } = Astro.props;
---

<p class={cardDescription({ class: className })} {...rest}>
  <slot />
</p>
