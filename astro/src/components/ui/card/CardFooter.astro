---
import { tv } from "tailwind-variants";

const cardFooter = tv({
  base: "flex items-center p-6 pt-0",
});

interface Props {
  class?: string;
  [key: string]: unknown;
}
const { class: className, ...rest } = Astro.props;
---

<div class={cardFooter({ class: className })} {...rest}>
  <slot />
</div>
