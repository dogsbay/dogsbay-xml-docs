---
import { tv } from "tailwind-variants";

const tabsList = tv({
  base: "flex items-center bg-muted p-1 text-muted-foreground border-b border-border",
});

interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<div
  class={tabsList({ class: className })}
  data-part="list"
  role="tablist"
  {...rest}
>
  <slot />
</div>
