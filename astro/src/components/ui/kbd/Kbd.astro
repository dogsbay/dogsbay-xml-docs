---
import { tv } from "tailwind-variants";
import { KBD_CLASS } from "./variants.js";

const kbd = tv({ base: KBD_CLASS });

interface Props {
  class?: string;
  [key: string]: unknown;
}
const { class: className, ...rest } = Astro.props;
---

<kbd class={kbd({ class: className })} {...rest}>
  <slot />
</kbd>
