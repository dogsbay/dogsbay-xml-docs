---
import { tv } from "tailwind-variants";

const tableCell = tv({
  base: "p-2 align-top [&:has([role=checkbox])]:pr-0",
});

interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<td class={tableCell({ class: className })} {...rest}>
  <slot />
</td>
