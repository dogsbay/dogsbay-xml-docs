---
import { tv } from "tailwind-variants";

const tableRow = tv({
  base: "border-b transition-colors hover:bg-muted/50 data-[state=selected]:bg-muted",
});

interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<tr class={tableRow({ class: className })} {...rest}>
  <slot />
</tr>
