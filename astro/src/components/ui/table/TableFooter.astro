---
import { tv } from "tailwind-variants";

const tableFooter = tv({
  base: "border-t bg-muted/50 font-medium [&>tr]:last:border-b-0",
});

interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<tfoot class={tableFooter({ class: className })} {...rest}>
  <slot />
</tfoot>
