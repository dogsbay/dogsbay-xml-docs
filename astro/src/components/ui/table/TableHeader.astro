---
import { tv } from "tailwind-variants";

const tableHeader = tv({
  base: "[&_tr]:border-b",
});

interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<thead class={tableHeader({ class: className })} {...rest}>
  <slot />
</thead>
