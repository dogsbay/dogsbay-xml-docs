---
import { tv } from "tailwind-variants";

const tableBody = tv({
  base: "[&_tr:last-child]:border-0",
});

interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className, ...rest } = Astro.props;
---

<tbody class={tableBody({ class: className })} {...rest}>
  <slot />
</tbody>
