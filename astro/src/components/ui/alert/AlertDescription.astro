---
import { tv } from "tailwind-variants";

const alertDescription = tv({
  base: "text-sm [&_p]:leading-relaxed",
});

interface Props {
  class?: string;
  [key: string]: unknown;
}
const { class: className, ...rest } = Astro.props;
---

<div class={alertDescription({ class: className })} {...rest}>
  <slot />
</div>
