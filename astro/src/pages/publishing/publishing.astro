      <h3 id="pdf" class="group scroll-mt-20">PDF<a href="#pdf" class="ml-2 text-muted-foreground opacity-0 group-hover:opacity-100 no-underline" aria-hidden="true" tabindex="-1" data-pagefind-ignore>&para;</a></h3>
